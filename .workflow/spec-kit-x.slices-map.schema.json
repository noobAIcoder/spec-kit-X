{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec-kit-x.slices-map.schema.json",
  "title": "Spec-Kit-X Slices Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "constitution_path", "slices"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "constitution_path": {
      "type": "string",
      "const": ".specify/memory/constitution.md"
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slice" }
    }
  },
  "$defs": {
    "sliceKey": {
      "type": "string",
      "pattern": "^S[0-9]{2,3}$"
    },
    "shortName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "short_name", "specify"],
      "properties": {
        "key": { "$ref": "#/$defs/sliceKey" },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "short-name": { "$ref": "#/$defs/shortName" },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/sliceKey" },
          "uniqueItems": true,
          "default": []
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "specify": {
          "type": "string",
          "minLength": 50,
          "pattern": "^[^\\r]*$",
          "description": "Exact text to pass as arguments to /prompts:speckit.specify."
        }
      }
    }
  }
}
